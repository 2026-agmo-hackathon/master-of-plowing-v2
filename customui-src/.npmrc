enable-pre-post-scripts=true

# @seamos/ads@1.0.0 declares a peer dependency on react@^18, while this dashboard
# runs on React 19. The components work on 19; only the peer range is stale.
# Without this, `npm ci` — which the SeamOS IDE runs for the React CustomUI build
# — fails with ERESOLVE on a fresh clone.
legacy-peer-deps=true
