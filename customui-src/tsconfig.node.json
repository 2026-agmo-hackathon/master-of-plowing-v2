{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "composite": true,
    "types": ["node", "pngjs", "pixelmatch"]
  },
  "include": ["vite.config.ts", "vite-api-plugin.ts", "playwright.config.ts", "tests/visual/**/*.ts"]
}
