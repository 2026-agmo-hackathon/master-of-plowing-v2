# This should most probably benefit from getting a "Requires:" field added
# dynamically by configure.
#
prefix=/var/jenkins_home/workspace/AL_CPP_Linux-Binary-Build_custom/Dependencies/INSTALL
exec_prefix=${prefix}
libdir=/var/jenkins_home/workspace/AL_CPP_Linux-Binary-Build_custom/Dependencies/INSTALL/lib
includedir=${prefix}/include
supported_protocols="DICT FILE FTP FTPS GOPHER GOPHERS HTTP HTTPS IMAP IMAPS MQTT POP3 POP3S RTSP SMB SMBS SMTP SMTPS TELNET TFTP"
supported_features="SSL IPv6 unixsockets libz AsynchDNS Largefile alt-svc HSTS NTLM HTTPS-proxy"

Name: libcurl
URL: https://curl.se/
Description: Library to transfer files with ftp, http, etc.
Version: 7.83.2-DEV
Libs: -L${libdir} -lcurl 
Libs.private:  -lgcc -lgcc_s -lc -lgcc -lgcc_s -ldl -lpthread /var/jenkins_home/workspace/AL_CPP_Linux-Binary-Build_custom/Dependencies/INSTALL/lib/libssl.so /var/jenkins_home/workspace/AL_CPP_Linux-Binary-Build_custom/Dependencies/INSTALL/lib/libcrypto.so /var/jenkins_home/workspace/AL_CPP_Linux-Binary-Build_custom/Dependencies/INSTALL/lib/libz.so
Cflags: -I${includedir} 
