include(CMakeFindDependencyMacro)
list(APPEND CMAKE_MODULE_PATH ${CMAKE_CURRENT_LIST_DIR})

FIND_PACKAGE(jsoncpp REQUIRED)
FIND_PACKAGE(EMF4CPP REQUIRED emf4cpp-ecore emf4cpp-ecorecpp)
FIND_PACKAGE(Threads REQUIRED)
FIND_PACKAGE(FCAL REQUIRED fcal-runtime)
FIND_PACKAGE(NEVONEX-FCAL-PLATFORM REQUIRED nevonex-fcal-platform)

set(Boost_USE_STATIC_LIBS OFF)
set(Boost_USE_MULTITHREADED ON)
set(Boost_USE_STATIC_RUNTIME OFF)
FIND_PACKAGE(Boost 1.73 COMPONENTS log log_setup filesystem REQUIRED)
add_definitions(-DBOOST_LOG_DYN_LINK)

list(REMOVE_AT CMAKE_MODULE_PATH -1)
include("${CMAKE_CURRENT_LIST_DIR}/@package_name@Targets.cmake")
